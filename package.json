{
  "name": "support-desk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev -w @support-desk/api\" \"npm run dev -w @support-desk/web\"",
    "db:seed": "npm run db:seed -w @support-desk/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "format": "biome check --write",
    "check": "biome check && npm run typecheck && npm test",
    "setup:check": "node scripts/setup-check.ts",
    "report:weekly": "node apps/api/src/weekly-report/print-weekly-report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
